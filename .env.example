# Canonical site origin (used for metadata, sitemap, Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://www.palmtreetechservices.com

# --- Enquiry delivery -------------------------------------------------------
# Recommended: create a free key at https://resend.com and verify your domain.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=palmtreeng@gmail.com
ENQUIRY_FROM_EMAIL=Palmtree Website <enquiries@yourdomain.com>

# Alternative to Resend: any endpoint that accepts a JSON POST
# (Formspree, Make, n8n, Zapier, your own CRM).
ENQUIRY_WEBHOOK_URL=
